{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "agent_theme_companion",
  "version": "0.2.0",
  "identifier": "com.agenttheme.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../themes": "themes"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
